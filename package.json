{
  "name": "@amineyarman/kinesis",
  "version": "2.0.0",
  "description": "CSS-native reactive motion for the web.",
  "main": "dist/kinesis.umd.js",
  "module": "dist/kinesis.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kinesis.es.js",
      "require": "./dist/kinesis.umd.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./src/text.ts",
      "default": "./src/text.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kinesis",
    "motion",
    "css",
    "interaction",
    "parallax",
    "tilt"
  ],
  "author": "Amine Bouyarmane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amineyarman/Kinesis.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^3.2.4"
  }
}
